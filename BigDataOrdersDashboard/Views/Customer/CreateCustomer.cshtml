@model Customer
@{
    ViewData["Title"] = "CreateCustomer";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<section class="content">
    <div class="container-fluid">
        <div class="row clearfix">
            <div class="block-header">
                <div class="row">
                    <div class="col-lg-7 col-md-6 col-sm-12">
                        <h2 style="white-space: nowrap;">Yeni Müşteri Oluşturma</h2>
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="card">
                    <div class="body">

                        <form method="post">
                            <label>Müşteri Adı</label>
                            <input type="text" asp-for="CustomerName" class="form-control" />
                            <br />
                            <label>Müşteri Soyadı</label>
                            <input type="text" asp-for="CustomerSurname" class="form-control" />
                            <br />
                            <label>Mail Adresi</label>
                            <input type="email" asp-for="CustomerEmail" class="form-control" />
                            <br />
                            <label>Telefon</label>
                            <input type="tel" asp-for="CustomerPhone" class="form-control" />
                            <br />
                            <label>Ülke</label>
                            <input type="text" asp-for="CustomerCountry" class="form-control" />
                            <br />
                            <label>Şehir</label>
                            <input type="text" asp-for="CustomerCity" class="form-control" />
                            <br />
                            <label>Bölge</label>
                            <input type="text" asp-for="CustomerDistrict" class="form-control" />
                            <br />
                            <label>Görsel <i>(URL Olarak Giriniz)</i></label>
                            <input type="text" asp-for="CustomerImageUrl" class="form-control" />
                            <br />
                            <label>Adres</label>
                            <input type="text" asp-for="CustomerAddress" class="form-control" />
                            <br />

                            <button class="btn btn-success">Müşteri Oluştur</button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


