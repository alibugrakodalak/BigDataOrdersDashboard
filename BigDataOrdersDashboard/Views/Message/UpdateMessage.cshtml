@model Message

@{
    ViewData["Title"] = "UpdateMessage";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<section class="content">
    <div class="container-fluid">
        <div class="row clearfix">
            <div class="block-header">
                <div class="row">
                    <div class="col-lg-7 col-md-6 col-sm-12">
                        <h2 style="white-space: nowrap;">Mesaj Güncelleme</h2>
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="card">
                    <div class="body">

                        <form method="post">
                            <input type="hidden" asp-for="MessageId" />
                            <label>Müşteri ID</label>
                            <input type="text" asp-for="CustomerId" class="form-control" />
                            <br />
                            <label>Konu</label>
                            <input type="text" asp-for="MessageSubject" class="form-control" />
                            <br />
                            <label>Mesaj İçeriği</label>
                            <textarea rows="5" class="form-control" asp-for="MessageText"></textarea>
                            <br />

                            <button class="btn btn-warning">Mesajı Güncelle</button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>







