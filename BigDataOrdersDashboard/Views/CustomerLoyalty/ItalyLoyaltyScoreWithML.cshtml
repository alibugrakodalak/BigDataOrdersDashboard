@model List<ResultLoyaltyScoreMLDto>

@{
    ViewData["Title"] = "ItalyLoyaltyScoreWithML";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}



<section class="content">

    <div class="block-header">
        <div class="row">
            <div class="col-lg-7 col-md-6 col-sm-12">
                ﻿
                <h2>
                    <img src="https://flagcdn.com/w20/it.png"
                         title="Italy"
                         alt="İtalya Bayrağı"
                         style="width:28px; height:auto; vertical-align:middle; margin-right:8px;">
                    İtalya Müşterileri Sadakat Skoru ML .Net
                </h2>
            </div>
        </div>
    </div>
    <div class="container-fluid">
        <div class="row clearfix">
            <div class="col-lg-12">
                <div class="card">
                    <div class="body">

                        <table class="table table-bordered table-hover">

                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Müşteri Adı</th>
                                    <th>Son Sipariş Günü</th>
                                    <th>Toplam Sipariş Sayısı</th>
                                    <th>Toplam Harcama / €</th>
                                    <th>Mevcut Sadakat Skoru</th>
                                    <th>ML Tahmini Skoru</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.CustomerName</td>
                                        <td>@item.Receny Gün Önce</td>
                                        <td>@item.Frequency</td>
                                        <td>@item.Monetary.ToString("N0") €</td>      
                                        <td class="@GetLoyaltyColor(item.ActualLoyaltyScore)">
                                            @item.ActualLoyaltyScore
                                        </td>
                                        <td class="@GetLoyaltyColor(item.PredictedLoyaltyScore)">
                                            @item.PredictedLoyaltyScore
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @functions{
                            public string GetLoyaltyColor(double score)
                            {
                                if (score >= 80)
                                    return "text-success fw-bold"; // Yüksek Sadakat
                                else if (score >= 50)
                                    return "text-warning fw-bold"; // Orta Sadakat
                                else
                                    return "text-danger fw-bold";  // Düşük Sadakat
                            }
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>











