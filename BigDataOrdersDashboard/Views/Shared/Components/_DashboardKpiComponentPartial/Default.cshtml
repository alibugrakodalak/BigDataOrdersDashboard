<div class="col-lg-3 col-md-4">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-6 col-sm-12">
            <div class="card top-report">
                <div class="body">
                    <h4 class="m-t-0">Aylık Ciro Hedefi<i class="@ViewBag.TrendingIconForMonth"></i></h4>

                    <p class="number">@ViewBag.MonthlyTarget.ToString("N0")</p>

                    <div class="progress">
                        <div class="progress-bar l-turquoise"
                             role="progressbar"
                             aria-valuenow="@Math.Round(ViewBag.MonthlyPercent, 0)"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             style="width:@Math.Round(ViewBag.MonthlyPercent, 0)%;">
                        </div>
                    </div>
                    <small>Gerçekleşen: <b>@ViewBag.MonthlyTotal.ToString("N0")</b></small>

                </div>
            </div>
        </div>

        <div class="col-lg-12 col-md-6 col-sm-12">
            <div class="card top-report">
                <div class="body">
                    <h4 class="m-t-0">Yıllık Ciro Hedefi<i class="@ViewBag.TrendingIconForYear"></i></h4>

                    <p class="text-muted">@ViewBag.YearTarget.ToString("N0")</p>

                    <div class="progress">
                        <div class="progress-bar l-blush"
                             role="progressbar"
                             aria-valuenow="@Math.Round(ViewBag.PercentageYear, 0)"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             style="width:@Math.Round(ViewBag.PercentageYear, 0)%;">
                        </div>
                    </div>
                    <small>Gerçekleşen: <b>@ViewBag.YearTotal.ToString("N0")</b></small>

                </div>
            </div>
        </div>

        <div class="col-lg-12 col-md-6 col-sm-12">
            <div class="card top-report">
                <div class="body">
                    <h4 class="m-t-0">Günlük Ürün Satış Hedefi<i class="@ViewBag.TrendingIconForProduct"></i></h4>

                    <p class="text-muted">@ViewBag.ProductTarget.ToString("N0")</p>

                    <div class="progress">
                        <div class="progress-bar l-parpl"
                             role="progressbar"
                             aria-valuenow="@Math.Round(ViewBag.PercentageProduct, 0)"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             style="width:@Math.Round(ViewBag.PercentageProduct, 0)%;">
                        </div>
                    </div>
                    <small>Gerçekleşen: <b>@ViewBag.ProductTotal.ToString("N0")</b></small>

                </div>
            </div>
        </div>
    </div>
</div>
