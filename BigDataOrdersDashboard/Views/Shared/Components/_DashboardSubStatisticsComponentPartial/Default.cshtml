<div class="col-lg-12">
    <div class="card">
        <ul class="row profile_state list-unstyled">
            <li class="col-lg-2 col-md-4 col-6">
                <div class="body">
                    <i class="zmdi zmdi-camera col-amber"></i>
                    <h4>@ViewBag.ProductCount.ToString("N0", new System.Globalization.CultureInfo("tr-TR"))</h4>
                    <span>Ürün</span>
                </div>
            </li>
            <li class="col-lg-2 col-md-4 col-6">
                <div class="body">
                    <i class="zmdi zmdi-thumb-up col-blue"></i>
                    <h4>@ViewBag.CategoryCount</h4>
                    <span>Farklı Kategori</span>
                </div>
            </li>
            <li class="col-lg-2 col-md-4 col-6">
                <div class="body">
                    <i class="zmdi zmdi-account col-red"></i>
                    <h4>@ViewBag.CustomerCount</h4>
                    <span>Müşteri</span>
                </div>
            </li>
            <li class="col-lg-2 col-md-4 col-6">
                <div class="body">
                    <i class="zmdi zmdi-attachment text-success"></i>
                    <h4>@ViewBag.OrderCount</h4>
                    <span>Sipariş</span>
                </div>
            </li>
            <li class="col-lg-2 col-md-4 col-6">
                <div class="body">
                    <i class="zmdi zmdi-desktop-mac text-info"></i>
                    <h4>@ViewBag.CountryCount</h4>
                    <span>Farklı Ülke</span>
                </div>
            </li>
            <li class="col-lg-2 col-md-4 col-6">
                <div class="body">
                    <i class="zmdi zmdi-attachment text-warning"></i>
                    <h4>@ViewBag.CityCount</h4>
                    <span>Farklı Şehir</span>
                </div>
            </li>
        </ul>
    </div>
</div>