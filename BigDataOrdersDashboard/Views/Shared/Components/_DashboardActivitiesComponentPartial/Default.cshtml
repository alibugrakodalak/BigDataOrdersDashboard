@model List<Product>

<div class="col-lg-4 col-md-6 col-sm-12">
    <div class="card activities">
        <div class="header">
            <h2>Kritik Stok Seviyeli Ürünler</h2>
            <ul class="header-dropdown m-r--5">
                <li class="dropdown">
                    <a href="javascript:void(0);" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false"> <i class="zmdi zmdi-more-vert"></i> </a>
                    <ul class="dropdown-menu slideUp ">
                        <li><a href="javascript:void(0);" class=" waves-effect waves-block">Yenile</a></li>
                        <li><a href="javascript:void(0);" class=" waves-effect waves-block">Akışa Git</a></li>
                    </ul>
                </li>
            </ul>
        </div>
        <div class="body">
            <div class="streamline b-l b-accent">

                @foreach (var item in Model)
                {
                    <div class="sl-item b-warning">
                        <div class="sl-content">
                            <div class="text-muted-dk"><b>@item.ProductName</b></div>
                            <p>Kalan Stok: <a href="" class="text-info">@item.StockQuantity</a></p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>