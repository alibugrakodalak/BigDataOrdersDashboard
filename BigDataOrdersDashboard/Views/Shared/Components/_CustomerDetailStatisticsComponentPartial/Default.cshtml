<div class="col-lg-12">
    <div class="card">
        <ul class="row profile_state list-unstyled">
            <li class="col-lg-2 col-md-4 col-6">
                <div class="body">
                    <i class="zmdi zmdi-camera col-amber"></i>
                    <h4>@ViewBag.TotalOrderCount.ToString("N0", new System.Globalization.CultureInfo("tr-TR"))</h4>
                    <span>Toplam Sipariş</span>
                </div>
            </li>
            <li class="col-lg-2 col-md-4 col-6">
                <div class="body">
                    <i class="zmdi zmdi-thumb-up col-blue"></i>
                    <h4>@ViewBag.CompletedOrderCount</h4>
                    <span>Tamamlanan Sipariş</span>
                </div>
            </li>
            <li class="col-lg-2 col-md-4 col-6">
                <div class="body">
                    <i class="zmdi zmdi-account col-red"></i>
                    <h4>@ViewBag.CanceledOrderCount</h4>
                    <span>İptal Edilen Sipariş</span>
                </div>
            </li>
            <li class="col-lg-2 col-md-4 col-6">
                <div class="body">
                    <i class="zmdi zmdi-attachment text-success"></i>
                    <h4>@ViewBag.GetCustomerCountry</h4>
                    <span>Ülke</span>
                </div>
            </li>
            <li class="col-lg-2 col-md-4 col-6">
                <div class="body">
                    <i class="zmdi zmdi-desktop-mac text-info"></i>
                    <h4>@ViewBag.GetCustomerCity</h4>
                    <span>Şehir</span>
                </div>
            </li>
            <li class="col-lg-2 col-md-4 col-6">
                <div class="body">
                    <i class="zmdi zmdi-attachment text-warning"></i>
                    <h4>100.000 €</h4>
                    <span>Toplam Harcanan Tutar</span>
                </div>
            </li>
        </ul>
    </div>
</div>
