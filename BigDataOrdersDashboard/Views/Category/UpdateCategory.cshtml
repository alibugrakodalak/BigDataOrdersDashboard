@model Category
@{
    ViewData["Title"] = "UpdateCategory";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="content">
    <div class="container-fluid">
        <div class="row clearfix">
            <div class="block-header">
                <div class="row">
                    <div class="col-lg-7 col-md-6 col-sm-12">
                        <h2 style="white-space: nowrap;">Kategori Güncelle</h2>
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="card">
                    <div class="body">

                        <form method="post"> <!--bu işlem sayfa post olduğunda çalışacak-->                            
                            <input type="hidden" asp-for="CategoryId" />
                            <label>Yeni Kategori Adı:</label>
                            <input type="text" asp-for="CategoryName" class="form-control" />
                            <br />
                            <button class="btn btn-success">Güncelle</button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

