@model Review

@{
    ViewData["Title"] = "UpdateReview";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="content">
    <div class="container-fluid">
        <div class="row clearfix">
            <div class="block-header">
                <div class="row">
                    <div class="col-lg-7 col-md-6 col-sm-12">
                        <h2 style="white-space: nowrap;">Yeni Yorum Ekleme</h2>
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="card">
                    <div class="body">

                        <form method="post">
                            <input type="hidden" asp-for="ReviewId" />
                            <label>Müşteri ID</label>
                            <input type="text" asp-for="CustomerId" class="form-control" />
                            <br />
                            <label>Ürün ID</label>
                            <input type="text" asp-for="ProductId" class="form-control" />
                            <br />
                            <label>Satın Alma Türü</label>
                            <input type="text" asp-for="PurchaseType" class="form-control" />
                            <br />
                            <label>Puan</label>
                            <input type="text" asp-for="Rating" class="form-control" />
                            <br />
                            <label>Yorum</label>
                            <input type="text" asp-for="ReviewText" class="form-control" />
                            <br />
                            <label>Duygu Analizi</label>
                            <input type="text" asp-for="Sentiment" class="form-control" />
                            <br />

                            <button class="btn btn-success">Güncelle</button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>







